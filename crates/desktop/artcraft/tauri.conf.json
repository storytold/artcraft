{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "ArtCraft",
  "version": "0.42.0",
  "identifier": "ai.artcraft.app",
  "build": {
    "frontendDist": "../../../frontend/apps/artcraft/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "nx run artcraft:dev",
    "beforeBuildCommand": "npx nx run artcraft:build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": {
        "default-src": [
          "'self'",
          "'unsafe-eval'",
          "'unsafe-inline'",
          "blob:",
          "data:",
          "https://*.fakeyou.com",
          "https://*.storyteller.ai",
          "https://www.google-analytics.com",
          "https://www.googletagmanager.com",
          "ipc://localhost",
          "tauri://localhost"
        ],
        "connect-src": [
          "'self'",
          "'unsafe-eval'",
          "'unsafe-inline'",
          "asset:",
          "blob:",
          "data:",
          "http://ipc.localhost",
          "https://*.clarity.ms",
          "https://*.fakeyou.com",
          "https://*.storyteller.ai",
          "https://asset.localhost",
          "https://unpkg.com/detect-gpu@5.0.70/",
          "https://www.google-analytics.com",
          "https://www.googletagmanager.com",
          "ipc://localhost",
          "tauri://localhost"
        ],
        "font-src": "*",
        "img-src": [
          "",
          "'self'",
          "'unsafe-inline'",
          "*",
          "blob:",
          "data:",
          "https://*.fakeyou.com",
          "https://*.storyteller.ai",
          "ipc://localhost",
          "tauri://localhost"
        ],
        "script-src": [
          "'self'",
          "'unsafe-eval'",
          "'unsafe-inline'",
          "'wasm-unsafe-eval'",
          "asset:",
          "blob:",
          "data:",
          "https://*.clarity.ms",
          "https://*.fakeyou.com",
          "https://*.storyteller.ai",
          "https://*.unpkg.com",
          "https://clarity.ms",
          "https://unpkg.com",
          "ipc://localhost",
          "tauri:",
          "tauri://localhost"
        ],
        "style-src": [
          "'self'",
          "'unsafe-eval'",
          "'unsafe-inline'",
          "blob:",
          "data:",
          "https://*.fakeyou.com",
          "https://*.storyteller.ai",
          "https://fonts.googleapis.com",
          "ipc://localhost",
          "tauri://localhost"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Intentional crafting engine for artists, designers, and filmmakers",
    "longDescription": "ArtCraft is an intentional crafting engine for artists, designers, and filmmakers. Generate and edit images, video, audio, 3D meshes and worlds.",
    "publisher": "Learning Machines LLC",
    "homepage": "https://getartcraft.com",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "graphics",
        "desktopTemplate": "linux/artcraft.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/artcraft.desktop"
      }
    }
  }
}
