{
  "name": "@artcraft/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Artcraft MCP server — Cloudflare Worker at mcp.getartcraft.com",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production",
    "gen:api": "node scripts/gen-api.mjs",
    "types": "wrangler types",
    "typecheck": "pnpm types && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format && pnpm test"
  },
  "dependencies": {
    "hono": "4.13.4",
    "openapi-fetch": "0.17.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "smol-toml": "1.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
