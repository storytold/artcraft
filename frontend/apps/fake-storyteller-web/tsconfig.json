{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "strict": true,
    "baseUrl": "../..",
    "paths": {
      "@storyteller/api/*": ["libs/api/src/lib/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
